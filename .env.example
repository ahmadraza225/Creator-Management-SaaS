# Postgres connection string (local, Neon, Supabase, Railway...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creators"
# Long random string used to sign login sessions: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
